# Copy to .env (not committed) or set in your host's environment.

# Postgres connection string. Leave unset in development to use the embedded PGlite database in .data/.
# DATABASE_URL=postgres://user:password@host:5432/vivid_milks

PORT=4000

# Development sign-in (trusts the x-user-id header). On by default outside production; never enable in production.
# DEV_AUTH=true

# Add sample data when the database is empty. On by default outside production.
# SEED_IF_EMPTY=true
